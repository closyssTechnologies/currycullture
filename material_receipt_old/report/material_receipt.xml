<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="report_material_receipt">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="material_receipt.material_receipt_external_layout">
                        <div class="page">
                            <div class="row mb-3">
                                <hr style="border: 3px solid black !important;"></hr>
                            </div>

                            <div class="row mb-3 text-bold">
                                <div class="col-7">
                                    <div class="text-bold mt-1">Vendor Address:</div>
                                    <div class="mt-1" t-field="o.partner_id.name"/>

                                    <div class="mt-1" t-field="o.partner_id.street"/>

                                    <div class="mt-1" t-field="o.partner_id.street2"/>

                                    <div class="mt-1" t-field="o.partner_id.city"/>

                                    <div class="mt-1" t-field="o.partner_id.state_id.name"/>

                                    <div class="mt-1" t-field="o.partner_id.country_id.name"/>
                                    <div class="mt-3">
                                        <hr>

                                        </hr>
                                    </div>
                                    <strong>
                                        <div class="mt-1">MRN DATE: <t t-esc="o.scheduled_date.strftime('%d-%m-%Y') or ''"/> </div>
                                    </strong>
                                    <strong>
                                        <div class="mt-1">MRN No.: <t t-esc="o.name or ''"/></div>
                                    </strong>
                                    <strong>
                                        <t t-if="o.purchase_id.date_approve">
                                             <div class="mt-1">Order DATE: <t t-esc="o.purchase_id.date_approve.strftime('%d-%m-%Y') or ''"/></div>
                                        </t>
                                        <t t-else="">
                                            <div class="mt-1">Order DATE:</div>
                                        </t>

                                    </strong>
                                    <strong>
                                        <div class="mt-1">Order No.: <t t-esc="o.purchase_id.name or ''"/></div>
                                    </strong>
                                    <strong>
                                        <div class="mt-1">Gate Entry Number: <t t-esc="o.gate_pass_no or ''"/></div>
                                    </strong>
                                    <strong>
                                        <div class="mt-1">Vehicle Number: <t t-esc="o.vehicle_no or ''"/></div>
                                    </strong>
                                    <strong>
                                        <t t-if="o.gate_received_date">
                                            <div class="mt-1">Received Date: <t t-esc="context_timestamp(o.gate_received_date).strftime('%d-%m-%Y') or ''"/></div>
                                        </t>
                                        <t t-else="">
                                            <div class="mt-1">Received Date:</div>
                                        </t>

                                    </strong>
                                    <strong>
                                        <t t-if="o.gate_received_date">
                                            <div class="mt-1">Received Time: <t t-esc="context_timestamp(o.gate_received_date).strftime('%H:%M')"/></div>
                                        </t>
                                        <t t-else="">
                                            <div class="mt-1">Received Time:</div>
                                        </t>
                                    </strong>
                                </div>

                                <div class="col-4" style="margin-left: 30px;">
                                    <div name="company_address">
                                        <ul class="list-unstyled">
                                            <li>
                                                <t t-if="o.company_id">
                                                    <t t-esc="o.company_id.name"/>
                                                </t>
                                                <t t-else="">

                                                </t>
                                            </li>
                                            <li class="mt-1">
                                                <t t-if="o.company_id.street">
                                                    <t t-esc="o.company_id.street"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>
                                            <li class="mt-1">
                                                <t t-if="o.company_id.street2">
                                                    <t t-esc="o.company_id.street2"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>

                                            <li class="mt-1">
                                                <t t-if="o.company_id.city">
                                                    <t t-esc="o.company_id.city"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>

                                            <li class="mt-1">
                                                <t t-if="o.company_id.state_id">
                                                    <t t-esc="o.company_id.state_id.name"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>

                                            <li class="mt-1">
                                                <t t-if="o.company_id.country_id">
                                                    <t t-esc="o.company_id.country_id.name"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>


                                            <li class="mt-1">
                                                GSTIN: <t t-esc="o.company_id.vat"/>
                                            </li>
                                            <li class="mt-1">
                                                Phone No:
                                                <t t-if="o.company_id.phone">
                                                    <t t-esc="o.company_id.phone"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>
                                            <li class="mt-1">
                                                Website:
                                                <t t-if="o.company_id.website">
                                                    <t t-esc="o.company_id.website"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>
                                            <li class="mt-1">
                                                Email:
                                                <t t-if="o.company_id.email">
                                                    <t t-esc="o.company_id.email"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>
                                            <li class="mt-1">
                                                Bank Name:
                                                <t t-if="o.company_id.partner_id.bank_account_name">
                                                    <t t-esc="o.company_id.partner_id.bank_account_name.bank_id.name"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>
                                            <li class="mt-1">
                                                Account Number:
                                                <t t-if="o.company_id.partner_id.bank_account_name">
                                                    <t t-esc="o.company_id.partner_id.bank_account_no"/>
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="mt-1">
                                        <hr>

                                        </hr>
                                    </div>


                                    <div class="text-bold mt-1">Warehouse Address:</div>
                                    <div class="mt-1" t-field="o.location_dest_id.warehouse_id.name"/>

                                    <div class="mt-1" t-field="o.location_dest_id.warehouse_id.partner_id.street"/>

                                    <div class="mt-1" t-field="o.location_dest_id.warehouse_id.partner_id.street2"/>

                                    <div class="mt-1" t-field="o.location_dest_id.warehouse_id.partner_id.city"/>

                                    <div class="mt-1"
                                         t-field="o.location_dest_id.warehouse_id.partner_id.state_id.name"/>

                                    <div class="mt-1"
                                         t-field="o.location_dest_id.warehouse_id.partner_id.country_id.name"/>
                                </div>
                            </div>

                            <div class="row mb-5 text-bold">
                                <div class="col-12">
                                    <table class="table table-bordered" style="border: 1px solid black !important;">
                                        <thead style="border: 1px solid black !important;">
                                            <tr class="text-center" style="border: 1px solid black !important;">
                                                <th>Sl. No.</th>
                                                <th>Code</th>
                                                <th>Product Name</th>
                                                <th>UoM</th>
                                                <th>Demand</th>
                                                <th>Received</th>
                                                <th>Rate</th>
                                                <th>Amount</th>
                                            </tr>
                                        </thead>
                                        <t t-set="o_index" t-value="0"/>
                                        <t t-set="sub_total_price" t-value="0"/>
                                        <tbody style="border: 1px solid black !important;">
                                            <tr t-foreach="o.move_ids_without_package" t-as="line"
                                                style="border: 1px solid black !important;">
                                                <t t-if="round(line.quantity, 3) > 0.000">
                                                    <td class="text-center">
                                                        <t t-esc="o_index + 1"/>
                                                        <t t-set="o_index" t-value="o_index + 1"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-esc="line.product_id.default_code"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-esc="line.product_id.name"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-esc="line.product_id.uom_id.name"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="'{:.3f}'.format(round(line.product_uom_qty, 3))"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="'{:.3f}'.format(round(line.quantity, 3))"/>
                                                    </td>
                                                    <td class="text-end">
                                                         <t t-esc="'{:.2f}'.format(round(line.purchase_line_id.price_unit, 2))"/>
                                                    </td>
                                                    <td class="text-end">

                                                        <t t-esc="'{:.2f}'.format(round(line.purchase_line_id.price_unit*line.quantity, 2))"/>

                                                        <t t-set="sub_total_price" t-value="sub_total_price+round(line.purchase_line_id.price_unit*line.quantity, 2)"/>
                                                    </td>
                                                </t>
                                            </tr>

                                            <tr style="border: 1px solid transparent !important;">
                                                <td colspan="7" class="text-end">
                                                    <strong>Total Amount</strong>
                                                </td>
                                                <td class="text-end">
<!--                                                    <t t-set="total_amount" t-value="0"/>-->
<!--                                                    <t t-foreach="o.move_ids_without_package" t-as="line">-->
<!--                                                        <t t-set="total_amount"-->
<!--                                                           t-value="total_amount + (line.purchase_line_id.price_subtotal)"/>-->
<!--                                                    </t>-->
                                                    <strong>
                                                        <t t-if="sub_total_price">
                                                             <t t-esc="'{:.2f}'.format(round(sub_total_price, 2))"/>

                                                        </t>
                                                        <t t-else="">
                                                        </t>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="row mt-5 text-bold" style="margin-top: 100px !important; page-break-inside: avoid !important;page-break-before: auto !important;">
                                <div class="col-3 text-center">
                                    Store Keeper
                                </div>

                                <div class="col-3 text-center">
                                    Prepared By
                                </div>

                                <div class="col-3 text-center">
                                    Quality Control
                                </div>

                                <div class="col-3 text-center">
                                    Purchase Manager
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <template id="material_receipt_external_layout">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <!--            <t t-if="company.external_report_layout_id" t-call="{{company.external_report_layout_id.sudo().key}}">-->
            <!--                <t t-out="0"/>-->
            <!--            </t>-->
            <t t-call="material_receipt.material_receipt_external_layout_standard">
                <t t-out="0"/>
            </t>

        </template>

        <template id="material_receipt_external_layout_standard">
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <div class="row">
                    <div class="col-4">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 100px;"
                             alt="Logo"/>
                    </div>

                    <div class="col-8">
                        <h3>
                            <strong>Material Receipt Note</strong>
                        </h3>
                    </div>
                </div>
            </div>

            <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout {{  'o_report_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}"
                 t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});"
                 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div>
                    <!-- This div ensures that the address is not cropped by the header. -->
                    <t t-call="web.address_layout"/>
                </div>
                <t t-out="0"/>
            </div>

            <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
<!--                <div class="col-12">-->
<!--                    <div class="text-bold mt-1">-->
<!--                        Pay-to-Address (Vendor)-->
<!--                    </div>-->
<!--                    <div class="mt-1" t-field="o.partner_id.name"/>-->

<!--                    <div class="mt-1" t-field="o.partner_id.street"/>-->

<!--                    <div class="mt-1" t-field="o.partner_id.street2"/>-->

<!--                    <div class="mt-1" t-field="o.partner_id.city"/>-->

<!--                    <div class="mt-1" t-field="o.partner_id.state_id.name"/>-->

<!--                    <div class="mt-1" t-field="o.partner_id.country_id.name"/>-->
<!--                </div>-->
            </div>
        </template>

        <record id="action_material_receipt_report" model="ir.actions.report">
            <field name="name">Material Receipt Note</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">material_receipt.report_material_receipt</field>
            <field name="report_file">material_receipt.report_material_receipt</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
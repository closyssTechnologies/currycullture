<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="resource_calendar_form_inherit" model="ir.ui.view">
            <field name="name">resource.calendar.form</field>
            <field name="model">resource.calendar</field>
            <field name="inherit_id" ref="resource.resource_calendar_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tz_offset']" position="replace">
                    <field name="checkout_time_for_single_punch" widget="float_time"/>
                </xpath>
            </field>
        </record>


        <odoo>

    <data noupdate="1">
        <record id="ir_cron_attendance_checkout" model="ir.cron">
            <field name="name">Set Missing Checkout Time</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.set_missing_checkout()</field>
            <field name="active" eval="True"/>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
            <field name="numbercall">-1</field>
<!--            <field name="nextcall" eval="(fields.Date.context_today(self) + timedelta(days=1, hours=23, minutes=45)).strftime('%Y-%m-%d %H:%M:%S')"/>-->
        </record>
    </data>
</odoo>
    </data>
</odoo>
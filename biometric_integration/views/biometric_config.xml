<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="biometric_config_form_view" model="ir.ui.view">
            <field name="name">biometric_config.form</field>
            <field name="model">biometric.config</field>
            <field name="arch" type="xml">
                <form string="Biometric Config" create="0">
                    <header>
                        <button name="register_new_company" type="object" string="Register Company" invisible="bio_company_name"/>
                        <button name="get_auth_token" type="object" string="Get AuthToken" invisible="not bio_company_name"/>
                        <button name="action_open_device_assignment" string="Add Device" type="object"  class="btn-primary" invisible="not bio_company_name"/>
                        <button name="action_open_add_group" string="Add Group" type="object"  class="btn-primary" invisible="not bio_company_name"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button type="object" class="oe_stat_button" id="open_devices" icon="fa-mobile"
                                    name="action_open_device_list">
                                <div class="o_stat_info">
                                    <span class="o_stat_value"><field name="device_count"/></span>
                                    <span class="o_stat_text">
                                        Device List
                                    </span>
                                </div>
                            </button>
                            <button type="object" class="oe_stat_button" id="open_groups_ou" icon="fa-group"
                                    name="action_open_group_list">
                                <div class="o_stat_info">
                                    <span class="o_stat_value"><field name="groups_count"/></span>
                                    <span class="o_stat_text">
                                       Groups
                                    </span>
                                </div>
                            </button>
                             <button name="action_open_attendance"
                                     type="object"
                                     class="oe_stat_button"
                                     icon="fa-clock-o">
                                 <field name="attendance_count" widget="statinfo" string="BioMetric Attendances" />
                             </button>
                             <button name="action_open_hr_attendance"
                                     type="object"
                                     class="oe_stat_button"
                                     icon="fa-clock-o">
                                 <field name="hr_attendance_count" widget="statinfo" string="Hr Attendances" />
                             </button>
                            <button name="action_open_hr_employee"
                                     type="object"
                                     class="oe_stat_button"
                                     icon="fa-user">
                                 <field name="employee_count" widget="statinfo" string="Hr Employees" />
                             </button>



                        </div>
                        <group>
                            <group>
                            <field name="bio_company_name" invisible="not bio_company_name"/>

                            </group>
                            <group>
                               <field name="biometric_configure_auth_token"  invisible="not bio_company_name"/>

                                <field name="attendance_inout_mode" />
                                <field name="attendance_inout_type" required="attendance_inout_mode == '10'" invisible="attendance_inout_mode != '10'"/>

                            </group>
                        </group>
                        <group></group>
                        <sheet invisible="not bio_company_name">
                        <group>

                            <field  name="device_ids" readonly="1">

                                    <tree string="Company Device List" create="0" delete="0" >
                                        <field name="cpuid" />
                                        <field name="device_name" />
                                        <field name="sub_type" />
                                        <field name="device_ip" />
                                        <field name="ou_code" />
                                        <field name="device_status"/>
                                        <field name="device_last_sync" />
                                    </tree>

                            </field>

                        </group>
                             </sheet>
                    </sheet>
                     <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user" options="{'post_refresh': 'recipients'}"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


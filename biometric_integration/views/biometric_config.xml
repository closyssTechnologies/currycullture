        <record id="biometric_config_act_window" model="ir.actions.act_window">
            <field name="name">Biometric Config</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">biometric.config</field>
            <field name="view_mode">form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Biometric Config.
                </p>
            </field>
        </record>

        <record id="action_open_first_biometric_config" model="ir.actions.server">
            <field name="name">Open First Biometric Config</field>
            <field name="model_id" ref="model_biometric_config"/>
            <field name="state">code</field>
            <field name="code">action = model.open_first_record()</field>
        </record>

        <menuitem name="Biometric Device Config" id="biometric_config_menu" parent="hr_attendance.menu_hr_attendance_root" sequence="20" action="action_open_first_biometric_config"/>

    </data>

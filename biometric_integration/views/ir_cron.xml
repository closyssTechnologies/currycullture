<?xml version="1.0"?>
<odoo>
  <data noupdate="1">

    <record id="ir_cron_get_attendance" model="ir.cron">
      <field name="name">Get Unsync Attendance Log</field>
      <field name="model_id" ref="biometric_integration.model_biometric_attendance_log"/>
      <field name="state">code</field>
      <field name="code">model._cron_sync()</field>
      <field name="active" eval="True"/>
      <field name="user_id" ref="base.user_root" />
      <field name="interval_number">15</field>
      <field name="interval_type">minutes</field>
      <field name="numbercall">-1</field>
      <field name="doall" eval="False"/>
    </record>

      <record id="ir_cron_sync_with_odoo_attendance" model="ir.cron">
          <field name="name">Synced with Odoo Attendance</field>
          <field name="model_id" ref="biometric_integration.model_biometric_attendance_log"/>
          <field name="state">code</field>
          <field name="code">model._cron_sync_with_odoo()</field>
          <field name="active" eval="True"/>
          <field name="user_id" ref="base.user_root"/>
          <field name="interval_number">12</field>
          <field name="interval_type">hours</field>
          <field name="numbercall">-1</field>
          <field name="doall" eval="False"/>
      </record>

      <record id="ir_cron_device_status" model="ir.cron">
          <field name="name">PI Bio sync Device status </field>
          <field name="model_id" ref="biometric_integration.model_biometric_config"/>
          <field name="state">code</field>
          <field name="code">model._cron_sync_company_device_status()</field>
          <field name="active" eval="True"/>
          <field name="user_id" ref="base.user_root"/>
          <field name="interval_number">10</field>
          <field name="interval_type">minutes</field>
          <field name="numbercall">-1</field>
          <field name="doall" eval="False"/>
      </record>
  </data>
</odoo>
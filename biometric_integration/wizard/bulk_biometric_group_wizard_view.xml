<odoo>
    <data>
        <record id="bulk_biometric_group_wizard_form" model="ir.ui.view">
            <field name="name">bulk.biometric.group.wizard.form</field>
            <field name="model">bulk.biometric.group.wizard</field>
            <field name="arch" type="xml">
                <form string="Assign Employees to group">
                    <group>
                        <group>
                            <field name="biometric_group"   required="1"/>
<!--                            <field name="employee_ids" />-->
                        </group>

                    </group>
                    <footer>
                       <button name="assign_employee_to_group" string="Save" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>





    </data>
</odoo>
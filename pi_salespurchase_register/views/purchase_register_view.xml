<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove duplicate from renamed module -->
    <delete model="ir.ui.menu" id="pi_purchase_register.menu_purchase_register_report"/>
    <delete model="ir.actions.act_window" id="pi_purchase_register.action_purchase_register_report"/>

    <!-- Tree View -->
    <record id="view_purchase_register_report_tree" model="ir.ui.view">
        <field name="name">purchase.register.report.tree</field>
        <field name="model">purchase.register.report</field>
        <field name="arch" type="xml">
            <tree string="Purchase Register" create="false" edit="false" delete="false">
                <field name="date_order" string="Date"/>
                <field name="purchase_order_no"/>
                <field name="transfer_no"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="product_uom"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="discount" string="Discount (%)"/>
                <field name="hsn_code" string="HSN Code"/>
                <field name="product_qty" sum="Total Quantity"/>
                <field name="qty_received" sum="Total Received"/>
                <!-- <field name="net_weight" sum="Total Net Weight"/> -->
                <field name="remaining_qty" sum="Total Remaining"/>
                <field name="is_billed"/>
                <field name="price_tax" sum="Total Tax Amount"/>
                <field name="tax_percentage"/>
                <field name="price_total" sum="Total Amount"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_register_report_search" model="ir.ui.view">
        <field name="name">purchase.register.report.search</field>
        <field name="model">purchase.register.report</field>
        <field name="arch" type="xml">
            <search string="Purchase Register Search">
                <field name="purchase_order_no"/>
                <field name="transfer_no"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="billed_yes" string="Billed" domain="[('is_billed', '=', 'yes')]"/>
                <filter name="billed_no" string="Not Billed" domain="[('is_billed', '=', 'no')]"/>
                <field name="date_order"/>
                <separator/>
                <filter name="date_order_filter" string="Date" date="date_order"/>
                <group expand="0" string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by':'partner_id'}"/>
                    <filter name="group_category" string="Product Category" context="{'group_by':'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_purchase_register_report" model="ir.actions.act_window">
        <field name="name">Purchase Register</field>
        <field name="res_model">purchase.register.report</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_purchase_register_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data found for Purchase Register.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_purchase_register_report"
              name="Purchase Register"
              parent="purchase.purchase_report_main"
              action="action_purchase_register_report"
              sequence="100"/>
</odoo>

<odoo>
    <record id="view_mrp_bom_form_inherit_category" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.category</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="before">
                <field name="bom_category_id" string="BOM Category"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Schedule action for generating automatic database backup-->
        <record id="ir_cron_auto_create_landed_cost" model="ir.cron">
            <field name="name">MO : Landed Cost Cron</field>
            <field name="model_id" ref="model_stock_landed_cost"/>
            <field name="state">code</field>
            <field name="code">model._landed_cost_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.utcnow().replace(hour=23, minute=45, second=0, microsecond=0) - timedelta(hours=5, minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>


    <template id="report_simple_label100x100">
        <t t-set="table_style"
           t-value="'width:10mm;height:10mm;' + table_style"/> <!-- Adjust cell size for 100x100 grid -->
        <td t-if="moves.product_id" t-att-style="make_invisible and 'visibility:hidden;'">
              <div style="text-align:left; font-size:24px; padding-top:15px;">
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px; font-size:24px; padding-top:10px;">
                    <span style="font-weight: bold; font-size: 15px;">Receiving Date:
                        <t t-esc="moves.picking_id.scheduled_date.date()"/>
                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px;">
                    <span style="font-weight: bold; font-size: 15px;">GRN NO:-
                        <t t-esc="moves.picking_id.name.split('/')[-1]"/>
                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px;">
                    <span style="font-weight: bold; font-size: 15px;">Supplier Name:-
                        <t t-esc="moves.picking_id.partner_id.name"/>
                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px;">
                    <span style="font-weight: bold; font-size: 15px;">Product Name:-
                        <t t-esc="moves.product_id.name"/>
                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px">
                    <span style="font-weight: bold; font-size: 15px;">Batch No:-
                        <t t-esc="moves.move_line_ids.lot_name"/>
                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px">
                    <span style="font-weight: bold; font-size: 15px;">MFG Date:-
                        <t t-esc="moves.mfg_date"/>
                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px">
                    <span style="font-weight: bold; font-size: 15px;">Best Before:-
                        <t t-if="moves.best_before">
                            <t t-esc="moves.best_before.strftime('%B - %Y') "/>
                        </t>
                        <t t-else="">
                            <span/>
                        </t>

                    </span>
                </div>
                <div class="o_label_data" style="margin-bottom: 1mm; padding-top: 15px;font-size:24px">
                    <span style="font-weight: bold; font-size: 15px;">Net Wt :
                        <t t-esc="moves.net_wt"/> :- <t t-esc="moves.product_uom.name"/>
                    </span>
                </div>
              </div>
        </td>
    </template>
    <template id="simple_report_product_label_100">
            <t t-call="web.html_container">
                <t t-set="table_style" t-value="'width:100%;height:100mm;'"/>
                <t t-set="padding_page" t-value="'padding: 1mm 1mm'"/>
                <t t-set="move_count" t-value="len(docs.move_ids)"/>
                <t t-foreach="enumerate(docs.move_ids)" t-as="move_enum">
                    <t t-set="index" t-value="move_enum[0]"/>
                    <t t-set="moves" t-value="move_enum[1]"/>
                    <t t-if="moves.product_id">
                        <t t-call="custom_product_label_report.report_simple_label100x100"/>
                        <!-- Add page break only if not the last item -->
                        <div t-if="index + 1 != move_count" style="page-break-after: always !important;"></div>
                    </t>
                </t>
            </t>
    </template>
    <record id="action_product_label_100" model="ir.actions.report">
        <field name="name">Incoming Product Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_product_label_report.simple_report_product_label_100</field>
        <field name="report_file">custom_product_label_report.simple_report_product_label_100</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="paperformat_id" ref="custom_product_label_report.paper_format_product_label_sheet_100"/>
    </record>
</odoo>



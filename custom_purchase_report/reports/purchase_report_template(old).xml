<odoo>
   <template id="custom_purchase_report">
     <t t-call="web.html_container">
         <t t-call="custom_purchase_report.external_layout_custom_purchase_report">
            <t t-foreach="docs" t-as="doc">
                 <t t-set="company" t-value="doc.company_id"/>
                     <div class="page">
                         <!-- Header Section -->
                         <div style="padding-top:5px;">
                             <div style="background-color:#c6c6c6;">
                                 <div style="border-top: 4px solid black; width: 100%; margin: 12px 0; background-color:#c6c6c6;"/>
                                 <h2 style="text-align: center; font-size:15px; vertical-align: bottom; background-color:#c6c6c6; padding-bottom:0px;margin-bottom:0px;">Purchase Order</h2>
                                 <div style="background-color:#c6c6c6; border-top: 2px solid black; width: 100%;"/>
                             </div>
<!--    .right-aligned {-->
<!--        width: 100%; /* Set the width of the div */-->
<!--        height: 100px; /* Optional: Define the height */-->
<!--        border: 1px solid black; /* Optional: Add a border for visibility */-->
<!--        text-align: left; /* Aligns content to the right */-->
<!--        padding-right: 10px; /* Optional: Add some padding on the right */-->
<!--    }-->
<!--</style>-->
<!--                        <div class="right-aligned">-->
<!--                            This content is aligned to the right.-->
<!--                        </div>-->

                             <table class="table" style="width: 100%; border: 1px solid black; background-color: #73a640; border-collapse: collapse;">
                                  <tr>
                                      <td style="text-align: center; font-size: 10px; font-weight: bold; padding: 5px; width: 50%; border-right: 1px solid black;">
                                          Vendor Details
                                      </td>
                                      <td style="text-align: center; font-size: 10px; font-weight: bold; padding: 5px; width: 50%;">
                                          PO Details
                                      </td>
                                  </tr>
                             </table>
                             <table class="table" style="width: 100%; border: 1px solid black; background-color: #c6c6c6; border-collapse: collapse;">
                                 <tr>
                                     <td style="text-align: center; font-size: 10px; font-weight: bold; padding: 5px; width: 50%; border-right: 1px solid black;">
                                         <!-- Remove the border from partner_id span -->
                                         <span style="width: 100%; height: 100px; text-align: left; padding-right: 10px;"
                                               t-field="docs.partner_id"/>
                                     </td>
                                     <td style="text-align: center; font-size: 10px; font-weight: bold; width: 50%;">
                                         <table style="width: 100%; padding:0px; margin:0px; border:0px; border-collapse: collapse;">
                                             <tr>
                                                 <td style="width:30%;border-right:1px solid black;border-bottom:1px solid black;">
                                                     PO No.
                                                 </td>
                                                 <td style="width:70%; border-bottom:1px solid black;">
                                                     <span t-field="docs.id"/>
                                                 </td>
                                             </tr>
                                             <tr>
                                                 <td style="width:30%;border-right:1px solid black;border-bottom:1px solid black;">
                                                     PO Date
                                                 </td>
                                                 <td style="width:70%;border-bottom:1px solid black;">
                                                     <span t-field="docs.date_order"/>
                                                 </td>
                                             </tr>
                                             <tr>
                                                 <td style="width:30%;border-right:1px solid black;border-bottom:1px solid black;">
                                                     PO Release Date
                                                 </td>
                                                 <td style="width:70%;border-bottom:1px solid black;">
                                                     <span t-field="docs.date_approve"/>
                                                 </td>
                                             </tr>
                                             <tr>
                                                 <td style="width:30%;border-right:1px solid black;border-bottom:1px solid black;">
                                                     Payment Terms
                                                 </td>
                                                 <td style="width:70%;border-bottom:1px solid black;">
                                                     <span t-field="docs.payment_term_id"/>
                                                 </td>
                                             </tr>
                                             <tr>
                                                 <td style="width:30%;border-right:1px solid black;border-bottom:1px solid black;">
                                                     Exp Delivery Date
                                                 </td>
                                                 <td style="width:70%;border-bottom:1px solid black;">
                                                     <span t-field="docs.date_planned"/>
                                                 </td>
                                             </tr>
                                             <tr>
                                                 <td style="width:30%;border-right:1px solid black;">
                                                     PO Expiry Date
                                                 </td>
                                                 <td style="width:70%;">
                                                     <span t-field="docs.date_planned"/>
                                                 </td>
                                             </tr>
                                         </table>
                                     </td>
                                 </tr>
                             </table>
                             <table class="table" style="width: 100%; border: 1px solid black; background-color: #73a640; border-collapse: collapse;">
                                  <tr>
                                      <td style="text-align: center; font-size: 10px; font-weight: bold; padding: 5px; width: 50%; border-right: 1px solid black;">
                                          Billing Address
                                      </td>
                                      <td style="text-align: center; font-size: 10px; font-weight: bold; padding: 5px; width: 50%;">
                                          Shipping  Address
                                      </td>
                                  </tr>
                             </table>
                             <table class="table" style="width: 100%; border: 1px solid black; background-color: #c6c6c6; border-collapse: collapse;">
                                <tr>
                                    <td style="text-align: center; font-size: 10px; font-weight: bold; padding: 5px; width: 50%; border-right: 1px solid black;">
                                        <!-- Remove the border from partner_id span -->
                                        <span style="width: 100%; height: 100px; text-align: left; padding-right: 10px;"
                                              t-field="docs.partner_id"/>
                                    </td>
                                    <td style="text-align: center; font-size: 10px; font-weight: bold; width: 50%;">

                                    </td>
                                </tr>
                             </table>
                             <table style="width: 100%; padding:0px; margin:0px; border:0px; border-collapse: collapse;">
                                  <thead style="background-color:#73a640;">
                                      <tr>
                                          <th style="border:1px solid #333;">Sl No</th>
                                          <th style="border:1px solid #333;">Item Description</th>
                                          <th style="border:1px solid #333;">HSN Code</th>
                                          <th style="border:1px solid #333;">Quantity</th>
                                          <th style="border:1px solid #333;">UOM</th>
                                          <th style="border:1px solid #333;">Rate</th>
                                          <th style="border:1px solid #333;">Taxable Value</th>
                                          <th style="border:1px solid #333;">Total Amount</th>
                                      </tr>
                                  </thead>
                                  <tbody style="background-color:#c6c6c6;">
                                       <t t-set="index" t-value="0"/>
                                      <t t-foreach="docs.order_line" t-as="line">
                                          <tr>
                                              <td style="border:1px solid #333;">
                                                  <t t-esc="index + 1"/>
                                                  <t t-set="index" t-value="index + 1"/>
                                              </td>
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.product_id.name"/>
                                              </td>
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.product_id.code"/>
                                              </td>
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.product_qty" t-options="{'widget': 'float'}"/>
                                              </td>
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.product_uom.name"/>
                                              </td>
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.price_unit"
                                                        t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                              </td>
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.price_subtotal"
                                                        t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                              </td>
                                              <!-- CGST -->
<!--                                              <td style="border:1px solid #333;">-->
<!--                                                  <span t-esc="line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'CGST')[0].amount if line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'CGST') else 0.0"/>-->
<!--                                                  %-->
<!--                                                  <span t-esc="line.price_subtotal * (line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'CGST')[0].amount / 100) if line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'CGST') else 0.0"/>-->
<!--                                              </td>-->
                                              <!-- SGST -->
<!--                                              <td style="border:1px solid #333;">-->
<!--                                                  <span t-esc="line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'SGST')[0].amount if line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'SGST') else 0.0"/>-->
<!--                                                  %-->
<!--                                                  <span t-esc="line.price_subtotal * (line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'SGST')[0].amount / 100) if line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'SGST') else 0.0"/>-->
<!--                                              </td>-->
                                              <!-- IGST -->
<!--                                              <td style="border:1px solid #333;">-->
<!--                                                  <span t-esc="line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'IGST')[0].amount if line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'IGST') else 0.0"/>-->
<!--                                                  %-->
<!--                                                  <span t-esc="line.price_subtotal * (line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'IGST')[0].amount / 100) if line.tax_ids.filtered(lambda tax: tax.tax_group_id.name == 'IGST') else 0.0"/>-->
<!--                                              </td>-->
                                              <td style="border:1px solid #333;">
                                                  <span t-field="line.price_total"
                                                        t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                              </td>
                                          </tr>
                                      </t>
                                  </tbody>
                                  <tfoot>
                                      <tr style="background-color:#e0e0e0;">
                                          <td colspan="6"
                                              style="text-align:right; font-weight:bold; border:1px solid #333;">Total
                                          </td>
                                          <td style="border:1px solid #333; font-weight:bold;">
                                              <!-- Total Taxable Value -->
                                              <t t-esc="sum(line.price_subtotal for line in docs.order_line)"
                                                 t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                          </td>
                                          <td style="border:1px solid #333; font-weight:bold;">
                                              <!-- Total Amount -->
                                              <t t-esc="sum(line.price_total for line in docs.order_line)"
                                                 t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                          </td>
                                      </tr>
                                  </tfoot>
                              </table>
                             <table style="width: 100%; border-collapse: collapse;">
                                 <tr style="background-color: #73a640; text-align: left;">
                                     <td colspan="3" style="font-size:12px; font-weight: bold; padding-top:5px; padding-bottom: 0px; border-bottom: 1px solid black;">
                                         Amount in Words: Two Lakhs Only
                                     </td>
                                 </tr>
                                 <tr style="background-color: #e0e0e0; text-align: center;">
                                     <td style="border: 1px solid black; padding: 10px; font-weight: bold;">
                                         Prepared By
                                     </td>
                                     <td style="border: 1px solid black; padding: 10px; font-weight: bold;">
                                         Verified By
                                     </td>
                                     <td style="border: 1px solid black; padding: 10px; font-weight: bold;">
                                         Authorized Signature
                                     </td>
                                 </tr>
                                  <tr style="border: 1px solid black;">
                                     <td colspan="3" style="font-size: 10px; padding-top: 5px; text-align:left;">
                                         <strong>Note</strong>: This is an electronically generated document; therefore, it does not
                                         require a physical signature.
                                     </td>
                                  </tr>
                                   <tr style="border: 1px solid black;">
                                     <td colspan="3" style="font-size: 13px; padding-top: 5px; text-align:center;background-color: #73a640;">
                                          <strong>Terms &amp; Condition</strong>
                                     </td>
                                   </tr>
                                   <tr style="border: 1px solid black;">
                                     <td colspan="3" style="font-size: 13px; padding: 5px; text-align:center;background-color: white;">

                                     </td>
                                   </tr>
                             </table>
                         </div>
                         </div>
            </t>
         </t>
    </t>
   </template>

   <template id="external_layout_custom_purchase_report">
    <t t-call="web.html_container">
        <div class="page">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id"/>
                <div class="header">
                      <table class="table" style="width: 100%; height:20px;">
                        <tr>
                            <td style="width: 50%; background-color: #c6c6c6;">
                                <t t-if="company.logo">
                                    <img t-att-src="'data:image/png;base64,%s' % company.logo" class="img-fluid" width="120" alt="Company Logo"/>
                                </t>
                            </td>
                            <td style="text-align: right; font-size: 10px; background-color: white; padding-bottom:5px;">
                                <p t-field="company.name"/>
                                <p t-field="company.street"/>
                                <p>
                                    <span t-field="company.city"/>,
                                    <span t-field="company.zip"/>
                                    <span t-field="company.country_id.name"/>
                                </p>
                                <p t-field="company.phone"/>
                                <p t-field="company.website"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <t t-raw="0"/> <!-- This is where the content of the report will be rendered -->

                <div class="footer" style="margin-top: 20px; text-align: center;">
                    <p>Confidential - For Internal Use Only</p>
                </div>
            </t>
        </div>
    </t>
   </template>
    <report
        id="action_report_custom_purchase"
        model="purchase.order"
        string="Custom Purchase Report"
        report_type="qweb-html"
        name="custom_purchase_report.custom_purchase_report"
        file="custom_purchase_report.custom_purchase_report"/>
</odoo>

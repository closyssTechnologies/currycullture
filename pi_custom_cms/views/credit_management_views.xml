<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- 📂 Parent Menu -->
    <!-- ========================= -->
    <menuitem id="menu_credit_management_root"
              name="Credit Management"
              parent="account.menu_finance_reports"
              sequence="50"/>

    <!-- ========================= -->
    <!-- 📋 List (Tree) View -->
    <!-- ========================= -->
    <record id="view_credit_management_list" model="ir.ui.view">
        <field name="name">credit.management.sheet.tree</field>
        <field name="model">credit.management.sheet</field>
        <field name="arch" type="xml">
            <tree string="Credit Management Sheet" create="true" delete="true">
                <header>
                    <button name="action_export_to_excel"
                            string="Export Excel"
                            type="object"
                            class="oe_highlight"/>
                </header>
                <field name="transaction_type"/>
                <field name="beneficiary_code"/>
                <field name="beneficiary_acc_no"/>
                <field name="amount"/>
                <field name="beneficiary_name"/>
                <field name="drawee_location"/>
                <field name="print_location"/>
                <field name="bene_address_1"/>
                <field name="bene_address_2"/>
                <field name="bene_address_3"/>
                <field name="bene_address_4"/>
                <field name="bene_address_5"/>
                <field name="instruction_reference_number"/>
                <field name="customer_reference"/>
                <field name="payment_details_1"/>
                <field name="payment_details_2"/>
                <field name="payment_details_3"/>
                <field name="payment_details_4"/>
                <field name="payment_details_5"/>
                <field name="payment_details_6"/>
                <field name="payment_details_7"/>
                <field name="cheque_number"/>
                <field name="chq_trn_date"/>
                <field name="micr_number"/>
                <field name="beneficiary_ifsc"/>
                <field name="bene_bank_name" column_invisible="1"/>
                <field name="bene_bank_branch_name"/>
                <field name="beneficiary_email"/>
            </tree>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 🧾 Form View -->
    <!-- ========================= -->
    <record id="view_credit_management_form" model="ir.ui.view">
        <field name="name">credit.management.sheet.form</field>
        <field name="model">credit.management.sheet</field>
        <field name="arch" type="xml">
            <form string="Credit Management Sheet">
                <sheet>
                    <group>
                        <group string="Vendor &amp; Transaction">
                            <field name="company_id" invisible="1"/>
                            <field name="company_partner_id" invisible="1"/>
                            <field name="vendor_id" required="1" options="{'no_create': True}"/>
                            <field name="company_bank" required="1"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Select Company Bank Account"/>
                            <field name="amount"/>
                            <field name="transaction_type" readonly="1"/>
                        </group>
                        <group string="Beneficiary Details">
                            <field name="beneficiary_name" readonly="1"/>
                            <field name="beneficiary_acc_no" readonly="1"/>
                            <field name="beneficiary_ifsc" readonly="1"/>
                            <field name="beneficiary_email" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Beneficiary &amp; Address Details">
                            <group>
                                <group>
                                    <field name="beneficiary_code"/>
                                    <field name="drawee_location"/>
                                    <field name="print_location"/>
                                </group>
                                <group>
                                    <field name="bene_address_1"/>
                                    <field name="bene_address_2"/>
                                    <field name="bene_address_3"/>
                                </group>
                            </group>
                        </page>

                        <page string="Payment Details">
                            <group>
                                <group>
                                    <field name="payment_details_1"/>
                                    <field name="payment_details_2"/>
                                    <field name="payment_details_3"/>
                                    <field name="payment_details_4"/>
                                </group>
                                <group>
                                    <field name="payment_details_5"/>
                                    <field name="payment_details_6"/>
                                    <field name="payment_details_7"/>
                                </group>
                            </group>
                        </page>

                        <page string="Bank &amp; Transaction Details">
                            <group>
                                <group>
                                    <field name="cheque_number"/>
                                    <field name="chq_trn_date"/>
                                    <field name="micr_number"/>
                                </group>
                                <group>
                                    <field name="bene_bank_name"/>
                                    <field name="bene_bank_branch_name"/>
                                    <field name="customer_reference"/>
                                    <field name="remarks"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 🔍 Search View -->
    <!-- ========================= -->
    <record id="view_credit_management_sheet_search" model="ir.ui.view">
        <field name="name">credit.management.sheet.search</field>
        <field name="model">credit.management.sheet</field>
        <field name="arch" type="xml">
            <search string="Credit Management Sheet">

                <field name="vendor_id" string="Vendor"/>

                <filter string="Internal (I)" name="filter_internal" domain="[('transaction_type','=','I')]"/>
                <filter string="NEFT (N)" name="filter_neft" domain="[('transaction_type','=','N')]"/>
                <filter string="RTGS (R)" name="filter_rtgs" domain="[('transaction_type','=','R')]"/>

                <group expand="1" string="Group By">
                    <filter string="Transaction Type" name="group_transaction_type" context="{'group_by':'transaction_type'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by':'vendor_id'}"/>
                </group>

                <searchpanel>
                    <field name="vendor_id" select="multi" enable_counters="1"/>
                </searchpanel>

            </search>
        </field>
    </record>

    <!-- ========================= -->
    <!-- ⚙️ Action -->
    <!-- ========================= -->
    <record id="action_credit_management_sheet" model="ir.actions.act_window">
        <field name="name">Credit Management Sheet</field>
        <field name="res_model">credit.management.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_credit_management_sheet_search"/>
    </record>

    <!-- ========================= -->
    <!-- 📤 Export Action -->
    <!-- ========================= -->
    <!--<record id="action_export_credit_management" model="ir.actions.server">
        <field name="name">Export to Excel</field>
        <field name="model_id" ref="model_credit_management_sheet"/>
        <field name="binding_model_id" ref="model_credit_management_sheet"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_export_to_excel()
        </field>
    </record>-->

    <!-- ========================= -->
    <!-- 🧭 Menu Item -->
    <!-- ========================= -->
    <menuitem id="menu_credit_management_entries"
              name="Credit Management Sheet"
              parent="menu_credit_management_root"
              action="action_credit_management_sheet"/>

</odoo>
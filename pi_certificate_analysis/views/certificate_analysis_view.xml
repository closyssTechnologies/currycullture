<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================== FORM VIEW ===================== -->
        <record id="view_pi_certificate_analysis_form" model="ir.ui.view">
            <field name="name">pi.certificate.analysis.form</field>
            <field name="model">pi.certificate.analysis</field>
            <field name="arch" type="xml">
                <form string="Certificate of Analysis">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="testing_date"/>
                                <field name="fssai_license_no"/>
                                <field name="product_id"/>
                                <field name="pack_size_qty"/>
                                <field name="city_name"/>
                                <field name="buyer"/>
                                <field name="invoice_no"/>
                                <field name="batch_qty"/>
                                <field name="carton_net_wt"/>
                                <field name="production_qty"/>
                            </group>
                            <group>
                                <field name="batch_no"/>
                                <field name="date_mfg"/>
                                <field name="date_expiry"/>
                                <field name="date_batch_release"/>
                                <field name="no_of_pkt_per_carton"/>
                                <field name="consigned_to"/>
                                <field name="product_dispatch_temp"/>
                                <field name="final_product_temp"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Parameters" name="parameters">
                                <separator string="PHYSICAL PARAMETERS"/>
                                <field name="physical_ids" context="{'default_param_type': 'physical'}">
                                    <tree editable="bottom">
                                        <field name="param_type" column_invisible="1"/>
                                        <field name="sr_no_physical" readonly="1" force_save="1"/>
                                        <field name="name"/>
                                        <field name="standard"/>
                                        <field name="test_report"/>
                                        <field name="test_method"/>
                                    </tree>
                                </field>

                                <separator string="MICROBIOLOGICAL PARAMETERS"/>
                                <field name="micro_ids" context="{'default_param_type': 'micro'}">
                                    <tree editable="bottom">
                                        <field name="param_type" column_invisible="1"/>
                                        <field name="sr_no_micro" readonly="1" force_save="1"/>
                                        <field name="name"/>
                                        <field name="standard"/>
                                        <field name="test_report"/>
                                        <field name="test_method"/>
                                    </tree>
                                </field>

                                <separator string="CHEMICAL PARAMETERS"/>
                                <field name="chemical_ids" context="{'default_param_type': 'chemical'}">
                                    <tree editable="bottom">
                                        <field name="param_type" column_invisible="1"/>
                                        <field name="sr_no_chemical" readonly="1" force_save="1"/>
                                        <field name="name"/>
                                        <field name="standard"/>
                                        <field name="test_report"/>
                                        <field name="test_method"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- Chatter & Activities on the right -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ===================== LIST / TREE VIEW ===================== -->
        <record id="view_pi_certificate_analysis_tree" model="ir.ui.view">
            <field name="name">pi.certificate.analysis.tree</field>
            <field name="model">pi.certificate.analysis</field>
            <field name="arch" type="xml">
                <tree string="Certificate of Analysis">
                    <field name="name" string="Reference" optional="show"/>
                    <field name="testing_date" string="Testing Date" optional="show"/>
                    <field name="batch_no" string="Batch No." optional="show"/>
                    <field name="fssai_license_no" string="FSSAI License No." optional="show"/>
                    <field name="date_mfg" string="Date of Manufacturing" optional="show"/>
                    <field name="product_id" string="Product Name" optional="show"/>
                    <field name="date_expiry" string="Date of Expiry" optional="show"/>
                    <field name="pack_size_qty" string="Pack Size/Quantity" optional="show"/>
                    <field name="date_batch_release" string="Date of Batch Release" optional="show"/>
                    <field name="city_name" string="City Name (Warehouse)" optional="show"/>
                    <field name="no_of_pkt_per_carton" string="Pkts per Carton" optional="show"/>
                    <field name="buyer" string="Buyer" optional="show"/>
                    <field name="consigned_to" string="Consigned To" optional="show"/>
                    <field name="invoice_no" string="Invoice No." optional="show"/>
                    <field name="product_dispatch_temp" string="Dispatch Temperature" optional="show"/>
                    <field name="batch_qty" string="Batch Quantity" optional="show"/>
                    <field name="final_product_temp" string="Final Product Temp." optional="show"/>
                    <field name="carton_net_wt" string="Carton Net Wt." optional="show"/>
                    <field name="production_qty" string="Production Qty (Kg)" optional="show"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                </tree>
            </field>
        </record>

        <!-- ===================== KANBAN VIEW ===================== -->
        <record id="view_pi_certificate_analysis_kanban" model="ir.ui.view">
            <field name="name">pi.certificate.analysis.kanban</field>
            <field name="model">pi.certificate.analysis</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="product_id">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="testing_date"/>
                    <field name="batch_no"/>
                    <field name="buyer"/>
                    <field name="date_expiry"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div>
                                            <span class="fw-bold">Product: </span>
                                            <field name="product_id"/>
                                        </div>
                                        <div>
                                            <span class="fw-bold">Batch No: </span>
                                            <field name="batch_no"/>
                                        </div>
                                        <div>
                                            <span class="fw-bold">Testing Date: </span>
                                            <field name="testing_date"/>
                                        </div>
                                        <div>
                                            <span class="fw-bold">Buyer: </span>
                                            <field name="buyer"/>
                                        </div>
                                        <div>
                                            <span class="fw-bold">Expiry: </span>
                                            <field name="date_expiry"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ===================== SEARCH VIEW ===================== -->
        <record id="view_pi_certificate_analysis_search" model="ir.ui.view">
            <field name="name">pi.certificate.analysis.search</field>
            <field name="model">pi.certificate.analysis</field>
            <field name="arch" type="xml">
                <search string="Search Certificate of Analysis">
                    <!-- Search fields -->
                    <field name="name" string="Reference"/>
                    <field name="product_id" string="Product"/>
                    <field name="batch_no" string="Batch No."/>
                    <field name="buyer" string="Buyer"/>
                    <field name="invoice_no" string="Invoice No."/>
                    <field name="fssai_license_no" string="FSSAI License No."/>
                    <field name="city_name" string="City"/>

                    <!-- Filters -->
                    <filter string="Testing This Month" name="filter_testing_month"
                            domain="[('testing_date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),('testing_date','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Expiring This Year" name="filter_expiry_year"
                            domain="[('date_expiry','&gt;=', context_today().strftime('%Y-01-01')),('date_expiry','&lt;=', context_today().strftime('%Y-12-31'))]"/>
                    <separator/>
                    <filter string="My Activities" name="filter_my_activities"
                            domain="[('activity_ids.user_id', '=', uid)]"/>
                    <filter string="Late Activities" name="filter_late"
                            domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>

                    <!-- Group By -->
                    <group expand="0" string="Group By">
                        <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                        <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer'}"/>
                        <filter string="Testing Date" name="group_testing_date" context="{'group_by': 'testing_date'}"/>
                        <filter string="Batch Release Date" name="group_batch_release" context="{'group_by': 'date_batch_release'}"/>
                        <filter string="City" name="group_city" context="{'group_by': 'city_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ===================== ACTION ===================== -->
        <record id="action_certificate_analysis" model="ir.actions.act_window">
            <field name="name">Certificate of Analysis</field>
            <field name="res_model">pi.certificate.analysis</field>
            <field name="view_mode">list,kanban,form,activity</field>
            <field name="search_view_id" ref="view_pi_certificate_analysis_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Certificate of Analysis
                </p>
            </field>
        </record>

        <!-- ===================== MENU ITEM ===================== -->
        <menuitem id="menu_certificate_analysis"
                  name="Certificate of Analysis"
                  parent="quality_control.menu_quality_control"
                  sequence="20"
                  action="action_certificate_analysis"/>

    </data>
</odoo>

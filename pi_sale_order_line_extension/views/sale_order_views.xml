<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend the embedded order_line tree view in sale order form -->
        <record id="view_order_form_line_custom" model="ir.ui.view">
            <field name="name">sale.order.form.line.tree.custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree" position="inside">
                    <field name="net_weight" string="Net Weight" optional="show"/>
                    <field name="gross_weight" string="Gross Weight" optional="show"/>
                    <field name="total_volume" optional="hide"/>
                    <field name="total_weight" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
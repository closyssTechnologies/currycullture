<odoo>
    <record id="view_quality_check_form" model="ir.ui.view">
        <field name="name">quality.check.form</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form" />
        <field name="arch" type="xml">
            <!-- Add a new tab for CCL Parameters -->
            <xpath expr="//notebook" position="inside">
                <page string="CCL Parameters">
                    <field name="ccl_parameter_ids" widget="one2many_list" nolabel="1">
                        <tree editable="bottom">
                            <field name="parameter_id" string="Parameter" readonly="1"/>
                            <field name="type_id" string="Type" readonly="1"/>
                            <field name="range" string="Range" readonly="1"/>
                            <field name="result" string="Result" />
                            <field name="remarks" string="Remarks" />
                            <field name="visibility" string="Visible" widget="boolean_toggle" />
                        </tree>
                        <form>
                            <group>
                                <field name="parameter_id" readonly="1"/>
                                <field name="type_id" readonly="1"/>
                                <field name="range" readonly="1"/>
                                <field name="result" />
                                <field name="remarks" />
                                <field name="visibility" widget="boolean_toggle" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_packing_export_pdf" model="report.paperformat">
        <field name="name">Packing Export A4</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_packing_export_pdf" model="ir.actions.report">
        <field name="name">Packing List for Export</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pi_packing_export_pdf.report_packing_list_template</field>
        <field name="report_file">pi_packing_export_pdf.report_packing_list_template</field>
        <field name="print_report_name">'Packing List for Export - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_packing_export_pdf"/>
    </record>
</odoo>

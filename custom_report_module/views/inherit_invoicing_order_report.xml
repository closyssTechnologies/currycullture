<odoo>
    <record id="action_report_invoicing" model="ir.actions.report">
        <field name="name">Tax Invoice CCL</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_report_module.custom_invoice_report</field>
        <field name="report_file">custom_report_module.custom_invoice_report</field>
        <field name="print_report_name">'%s' %('Tax Invoice' if object.move_type == 'out_invoice' else 'Purchase Invoice')</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="sale.model_account_move"/>
    </record>
</odoo>

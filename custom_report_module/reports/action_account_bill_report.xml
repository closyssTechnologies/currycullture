                                        <td colspan="3" style="font-size: 10px; padding-top: 5px; text-align:left;">
                                            <strong>Note:</strong>
                                            <span style="padding:0px;margin:0px;" t-field="docs.remarks"/>
                                        </td>
                                    </tr>
                                   <tr style="border: 1px solid black;">
                                     <td colspan="3" style="font-size: 13px; padding-top: 5px; text-align:center;background-color: #73a640;">
                                          <strong>Terms &amp; Condition</strong>
                                     </td>
                                   </tr>
                                   <tr style="border: 1px solid black; background-color: #FFFFFF;">
                                     <td colspan="3" style="font-size: 13px; padding: 5px; text-align:left !important;">
                                        <span style="padding:0px;margin:0px;" t-field="docs.narration"/>
                                     </td>
                                   </tr>
                             </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="external_layout_custom_account_bill_report">
        <t t-call="web.html_container">
            <div class="page" style="border: none !important;background-color: #FFFFFF;">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="company" t-value="docs.company_id"/>
                    <div class="header" style="border: none;">
                        <table class="table table-bordered"
                               style="border-color:white; width: 100%; border-collapse: collapse;">
                            <tr style="border: none !important;">
                                <td style="border: none;width: 50%; background-color: #FFFFFF;">
                                    <t t-if="company.logo">
                                        <!--                                     <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"  alt="Logo"/>-->
                                        <img t-att-src="image_data_uri(company.logo)"
                                             style="padding-left:35px;padding-top:20px;width:200px; height: 100px;padding-bottom:0px;"
                                             alt="Company Logo"/>
                                    </t>
                                </td>
                                <td style="border: none;width: 50%; text-align: right; padding: 10px; height:100px;font-size:10px;">
                                    <strong t-esc="doc.company_id.name"/>
                                    <br/>
                                    <span t-esc="doc.company_id.street or ''"/>
                                    <t t-if="doc.company_id.street2">
                                        <br/>
                                        <span t-esc="doc.company_id.street2"/>
                                    </t>
                                    <br/>
                                    <span t-esc="doc.company_id.city or ''"/>
                                    <t t-if="doc.company_id.state_id">
                                        <span t-esc="doc.company_id.state_id.name"/>
                                    </t>
                                    ,
                                    <span t-esc="doc.company_id.zip or ''"/>
                                    <br/>
                                    <span t-esc="doc.company_id.country_id.name if doc.company_id.country_id else ''"/>
                                    <br/>
                                    Website:
                                    <span t-esc="doc.company_id.website or ''"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <t t-raw="0"/>
                </t>
            </div>
        </t>

    </template>


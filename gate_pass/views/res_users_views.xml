<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Gate Entry field to Users -->
        <record id="gate_entry_field_manager_only" model="ir.model.fields">
            <field name="model_id" ref="base.model_res_users"/>
            <field name="name">x_gate_entry_manager</field>
            <field name="field_description">Gate Entry</field>
            <field name="ttype">selection</field>
            <field name="selection">[("manager", "Manager")]</field>
        </record>

        <!-- Add field to User form -->
        <record id="view_users_form_gate_entry" model="ir.ui.view">
            <field name="name">res.users.form.gate.entry</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Gate Entry">
                        <group>
                            <field name="x_gate_entry_manager"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
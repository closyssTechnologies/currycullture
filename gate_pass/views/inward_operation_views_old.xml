<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inward Operation Form View -->
        <record id="view_inward_operation_form" model="ir.ui.view">
            <field name="name">inward.operation.form</field>
            <field name="model">inward.operation</field>
            <field name="arch" type="xml">
                <form string="Inward Operation">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="vendor_invoice_no"/>
                                <field name="purchase_order_id" options="{'no_create': False, 'no_open': False}"/>
                                <field name="vendor_id" readonly="1" force_save="1"/>
                                <field name="gatekeeper_user_id"/>
                                <field name="weight"/>
                            </group>
                            <group>
                                <field name="vehicle_no"/>
                                <field name="eway_bill"/>
                                <field name="invoice_date"/>
                                <field name="receiving_date" widget="datetime"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products">
                                <field name="product_line_ids" readonly="1" force_save="1">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="ordered_qty"/>
                                        <field name="receiving_qty"/>
                                        <field name="balance_qty" readonly="1"/>
                                        <field name="bill_quantity"/>
                                        <field name="uom_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Inward Operation Tree View -->
        <record id="view_inward_operation_tree" model="ir.ui.view">
            <field name="name">inward.operation.tree</field>
            <field name="model">inward.operation</field>
            <field name="arch" type="xml">
                <tree string="Inward Operations">
                    <field name="name"/>
                    <field name="purchase_order_id"/>
                    <field name="vendor_id"/>
                    <field name="vehicle_no"/>
                    <field name="invoice_date"/>
                    <field name="receiving_date"/>
                </tree>
            </field>
        </record>

        <!-- Inward Operation Action -->
        <record id="action_inward_operation" model="ir.actions.act_window">
            <field name="name">Inward Operation</field>
            <field name="res_model">inward.operation</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Sequence for Inward Operation -->
        <record id="seq_inward_operation" model="ir.sequence">
            <field name="name">Inward Operation</field>
            <field name="code">inward.operation</field>
            <field name="prefix">GI/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Block deletion of confirmed sale orders for non-admin users -->
        <record id="sale_order_delete_confirmed_rule" model="ir.rule">
            <field name="name">Block Delete Confirmed Sale Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('state', 'not in', ['sale', 'done'])]</field>
            <field name="groups" eval="[(4, ref('gate_pass.group_gate_pass_manager')), (4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Block deletion of confirmed purchase orders for non-admin users -->
        <record id="purchase_order_delete_confirmed_rule" model="ir.rule">
            <field name="name">Block Delete Confirmed Purchase Orders</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[('state', 'not in', ['purchase', 'done'])]</field>
            <field name="groups" eval="[(4, ref('gate_pass.group_gate_pass_manager')), (4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Block deletion of inward operations linked to confirmed POs for non-admin users -->
        <record id="inward_operation_delete_rule" model="ir.rule">
            <field name="name">Block Delete Inward Operations with Confirmed PO</field>
            <field name="model_id" ref="gate_pass.model_inward_operation"/>
            <field name="domain_force">['|', ('purchase_order_id', '=', False), ('purchase_order_id.state', 'not in', ['purchase', 'done'])]</field>
            <field name="groups" eval="[(4, ref('gate_pass.group_gate_pass_manager')), (4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Block deletion of outward gate entries linked to confirmed SOs for non-admin users -->
        <record id="outward_gate_entry_delete_rule" model="ir.rule">
            <field name="name">Block Delete Outward Gate Entries with Confirmed SO</field>
            <field name="model_id" ref="gate_pass.model_outward_gate_entry"/>
            <field name="domain_force">['|', ('sale_order_id', '=', False), ('sale_order_id.state', 'not in', ['sale', 'done'])]</field>
            <field name="groups" eval="[(4, ref('gate_pass.group_gate_pass_manager')), (4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Admin has full access - no restrictions for administrators -->
        <record id="sale_order_admin_full_rule" model="ir.rule">
            <field name="name">Sale Order Admin Full Access</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="purchase_order_admin_full_rule" model="ir.rule">
            <field name="name">Purchase Order Admin Full Access</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="inward_operation_admin_full_rule" model="ir.rule">
            <field name="name">Inward Operation Admin Full Access</field>
            <field name="model_id" ref="gate_pass.model_inward_operation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="outward_gate_entry_admin_full_rule" model="ir.rule">
            <field name="name">Outward Gate Entry Admin Full Access</field>
            <field name="model_id" ref="gate_pass.model_outward_gate_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>